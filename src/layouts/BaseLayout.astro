---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import MobileBar from "../components/MobileBar.astro";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import serifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import { business, missingValues } from "../data/business";
import { media, hasClip, type MuxClip } from "../data/media";
import { projects } from "../data/projects";
import {
  businessNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  faqNode,
  videoNode,
  type Crumb,
} from "../lib/schema";

export type { Crumb };

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  /** schema.org page type: WebPage, AboutPage, ContactPage, CollectionPage… */
  pageType?: string;
  /** @id of the main entity this page is about (defaults to the business). */
  about?: string;
  /** Extra schema nodes for this page (Service, etc.). */
  schema?: object[];
  faqs?: { q: string; a: string }[];
  videos?: { key: string; clip: MuxClip }[];
  header?: "overlay" | "solid";
  finalCta?: boolean;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  breadcrumbs = [],
  pageType,
  about,
  schema = [],
  faqs = [],
  videos = [],
  header = "overlay",
  finalCta = true,
  noindex = false,
  ogImage = "/og-default.jpg",
} = Astro.props;

const site = (Astro.site?.toString() ?? business.siteUrl).replace(/\/$/, "");
const path = Astro.url.pathname;
const canonical = site + path;

if (missingValues.length && path === "/") {
  console.warn(`\n[GM Roofing] Before launch, fill in src/data/business.ts: ${missingValues.join(", ")}\n`);
}

const graph = noindex
  ? []
  : [
      businessNode(),
      websiteNode(),
      webPageNode({ path, title, description, type: pageType, about, hasBreadcrumb: breadcrumbs.length > 0, primaryImage: site + ogImage }),
      ...(breadcrumbs.length ? [breadcrumbNode(path, breadcrumbs)] : []),
      ...schema,
      ...(faqs.length ? [faqNode(path, faqs)] : []),
      ...videos.map((v) => videoNode(path, v.clip, v.key)).filter(Boolean),
    ];

const usesMux =
  hasClip(media.hero) || hasClip(media.projectFilm) || Object.values(media.services).some(hasClip) || projects.length > 0;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="theme-color" content="#0a1a2b" />
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Sacramento" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      usesMux && (
        <>
          <link rel="preconnect" href="https://image.mux.com" crossorigin />
          <link rel="preconnect" href="https://stream.mux.com" crossorigin />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site + ogImage} />

    <script is:inline>document.documentElement.classList.add("js");</script>
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header mode={header} />
    <main id="main">
      <slot />
    </main>
    {finalCta && <CtaBand />}
    <Footer />
    {path !== "/contact/" && <MobileBar />}

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
