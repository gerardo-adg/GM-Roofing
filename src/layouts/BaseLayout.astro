---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import MobileBar from "../components/MobileBar.astro";
import { business, hasPhone, hasEmail, missingValues } from "../data/business";

export type Crumb = { label: string; href: string };

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (Service, WebSite…). */
  schema?: object[];
  breadcrumbs?: Crumb[];
  header?: "overlay" | "solid";
  finalCta?: boolean;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  schema = [],
  breadcrumbs = [],
  header = "overlay",
  finalCta = true,
  noindex = false,
  ogImage = "/og-default.jpg",
} = Astro.props;

const site = (Astro.site?.toString() ?? business.siteUrl).replace(/\/$/, "");
const canonical = site + Astro.url.pathname;

if (missingValues.length && Astro.url.pathname === "/") {
  console.warn(`\n[GM Roofing] Before launch, fill in src/data/business.ts → ${missingValues.join(", ")}\n`);
}

const org: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: business.name,
  description: business.descriptionShort,
  url: business.siteUrl,
  areaServed: business.cities.map((c) => ({ "@type": "City", name: c })),
};
if (hasPhone) org.telephone = business.phone.tel;
if (hasEmail) org.email = business.email;
if (business.address.showOnSite && business.address.streetAddress) {
  org.address = {
    "@type": "PostalAddress",
    streetAddress: business.address.streetAddress,
    addressLocality: business.address.addressLocality,
    addressRegion: business.address.addressRegion,
    postalCode: business.address.postalCode || undefined,
  };
}
const sameAs = Object.values(business.social).filter(Boolean);
if (sameAs.length) org.sameAs = sameAs;

const schemas: object[] = [org, ...schema];
if (breadcrumbs.length) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.label,
      item: site + b.href,
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a1a2b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>document.documentElement.classList.add("js");</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header mode={header} />
    <main id="main">
      <slot />
    </main>
    {finalCta && <CtaBand />}
    <Footer />
    {Astro.url.pathname !== "/contact/" && <MobileBar />}

    <script>
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-in"));
      }
    </script>
  </body>
</html>
