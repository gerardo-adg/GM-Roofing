---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import Icon from "../components/Icon.astro";
import { business } from "../data/business";
import { story } from "../data/story";
import { reviews, reviewsUrl } from "../data/reviews";
import MuxFilm from "../components/MuxFilm.astro";
import { media, hasClip } from "../data/media";
import { aboutHeroImage } from "../data/images";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
];

const owner = business.owner.name || "The owner";
const ownerShort = business.owner.name ? business.owner.name.split(" ")[0] : "He";

const values = [
  { title: "Easy to reach, easy to talk to", text: "You'll know what's happening with your roof and what comes next, explained in plain language." },
  { title: "We'll say when a repair is enough", text: "If a repair solves the problem, that's what we recommend instead of a new roof." },
  { title: "We fix what's under the shingles", text: "Soft decking and worn flashing get repaired before the new roof goes on." },
  { title: "Your property stays protected", text: "We protect landscaping, driveways and gutters, and clean up before we leave." },
];
---

<BaseLayout
  title="About GM Roofing | Family-Owned Sacramento Roofer"
  description="GM Roofing's owner started roofing with his dad at nine years old. Today he runs a licensed, family-owned roofing company serving Sacramento and the Sacramento Valley."
  breadcrumbs={breadcrumbs}
  pageType="AboutPage"
  videos={hasClip(media.owner) ? [{ key: "owner", clip: media.owner }] : []}
>
  <PageHero
    eyebrow="Our story"
    title="Started on the roof at <em>nine years old.</em>"
    image={aboutHeroImage}
    lede={`${owner} grew up on job sites with his dad. Today he runs his own licensed roofing company across the ${business.primaryRegion}.`}
    breadcrumbs={breadcrumbs}
  />

  <!-- ============ OWNER FILM (once media.owner has a Mux ID) ============ -->
  {
    hasClip(media.owner) && (
      <section class="ownerfilm">
        <div class="container">
          <div data-reveal="media"><MuxFilm clip={media.owner} /></div>
        </div>
      </section>
    )
  }

  <!-- ============ STORY ============ -->
  <section class="section">
    <div class="container story">
      <div class="story__copy">
        {
          business.owner.photo && (
            <figure class="story__photo" data-reveal="media">
              <img src={business.owner.photo} alt={`${owner}, owner of ${business.name}`} loading="lazy" />
            </figure>
          )
        }
        <p class="story__lead" data-reveal>
          It started with tagging along with his dad on roofing jobs. Over the years, he learned the trade one piece at a time and kept{" "}
          <em>getting more involved.</em>
        </p>
        <div class="story__body">
          <p data-reveal>
            Ever since he was a kid, he knew he wanted to be a contractor. Back then he didn't even know there were different kinds. He'd watch contractors pull up in big trucks and think, that's going to be me one day.
          </p>
          <p data-reveal>
            By 15 he was picking up side jobs of his own. He got good at the work, and found out he was just as good at the other half of the job: talking with homeowners, explaining what their roof needs and making the whole process easy.
          </p>
          <p data-reveal>
            When it came time to get his contractor's license, he passed both the trade exam and the Law and Business exam on the first try. Today he holds California C-39 roofing license #{business.license.number} and runs his own company across the {business.primaryRegion}. The name is his own, too: GM stands for Giovanni Mondragon.
          </p>
        </div>
      </div>

      <ol role="list" class="timeline" data-stagger>
        {
          story.milestones.map((m) => (
            <li data-reveal>
              <span class="timeline__when">{m.when}</span>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="section section--dark quote">
    <div class="container">
      <figure>
        <blockquote data-reveal="lines">
          <span class="l"><span class="l__in">“{story.quote}”</span></span>
        </blockquote>
        <figcaption data-reveal style="--d:3">{business.owner.name ? `${business.owner.name}, owner` : `Owner, ${business.name}`}</figcaption>
      </figure>
      <div class="quote__advice" data-reveal style="--d:4">
        <span class="eyebrow">His advice to anyone starting out</span>
        <p>“{story.advice}”</p>
      </div>
    </div>
  </section>

  <!-- ============ COMMUNICATION ============ -->
  <section class="section">
    <div class="container talk">
      <div>
        <span class="eyebrow" data-reveal>What customers mention most</span>
        <h2 data-reveal="lines"><span class="l"><span class="l__in">Easy to</span></span><span class="l"><span class="l__in"><em>talk to.</em></span></span></h2>
      </div>
      <div class="talk__body">
        <p data-reveal style="--d:1">
          Ask {ownerShort === "He" ? "his" : `${ownerShort}'s`} customers what they appreciated and you'll hear the same thing: how easy he is to communicate with. He explains what's going on with your roof in plain language, answers your questions and tells you what happens next.
        </p>
        <p data-reveal style="--d:2">
          That's the job as much as the roofing is. You should never have to wonder where your project stands.
        </p>
        {
          reviews[1] && (
            <figure class="talk__quote" data-reveal style="--d:3">
              <blockquote><p>“He came the next day to give us his bid, was prepared and able to answer all our questions. His communication was excellent and transparent throughout the process.”</p></blockquote>
              <figcaption>{reviews[1].name}, on <a href={reviewsUrl} target="_blank" rel="noopener">Yelp</a></figcaption>
            </figure>
          )
        }
        <a class="btn btn--dark" href="/contact/" data-reveal style="--d:3">Request a free estimate</a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <SectionHead align="split" eyebrow="Our approach" title="How we <em>work.</em>" />
      <ol role="list" class="values" data-stagger>
        {
          values.map((v, i) => (
            <li data-reveal>
              <span class="values__num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <SectionHead align="split" eyebrow="The process" title="Four steps, <em>in writing.</em>" />
      <ProcessSteps />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead align="split" eyebrow="Services" title="What we <em>do.</em>" />
      <ServiceGrid exclude={["residential-roofing-sacramento"]} />
    </div>
  </section>
</BaseLayout>

<style>
  /* Owner film overlaps the hero */
  .ownerfilm { position: relative; z-index: 2; margin-top: clamp(-3rem, -6vw, -2rem); }
  :global(.phero):has(+ .ownerfilm) { padding-bottom: clamp(5rem, 10vw, 8rem); }

  /* Story */
  .story { display: grid; gap: 3.5rem; }
  .story__photo { overflow: hidden; border-radius: var(--radius-lg); margin-bottom: 2.5rem; max-width: 420px; }
  .story__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .story__lead {
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 550;
    max-width: 24ch;
    text-wrap: balance;
  }
  .story__lead em { font-style: normal; color: var(--accent); }
  .story__body { margin-top: 2rem; }
  .story__body p { color: #3a4a5b; font-size: var(--fs-lg); max-width: 58ch; }
  .story__body p + p { margin-top: 1.25rem; }

  .timeline { position: relative; display: grid; gap: 0; align-content: start; padding-left: 1.75rem; }
  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--line);
  }
  .timeline li { position: relative; padding-bottom: 2rem; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before {
    content: "";
    position: absolute;
    left: calc(-1.75rem + 1px);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--white);
    border: 2px solid var(--accent);
  }
  .timeline li:last-child::before { background: var(--accent); }
  .timeline__when { font-weight: 600; letter-spacing: -0.03em; font-size: 1.35rem; line-height: 1; color: var(--accent); }
  .timeline p { margin-top: 0.5rem; color: var(--steel); font-size: var(--fs-sm); max-width: 36ch; }

  @media (min-width: 1024px) {
    .story { grid-template-columns: 1.5fr 1fr; gap: 6rem; align-items: start; }
    .timeline { position: sticky; top: calc(var(--header-h) + 2rem); margin-top: 0.5rem; }
  }

  /* Quote */
  .quote blockquote {
    font-size: clamp(1.9rem, 1.2rem + 3vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 550;
    max-width: 24ch;
    text-wrap: balance;
  }
  .quote figcaption { margin-top: 1.75rem; color: rgb(255 255 255 / 0.6); font-size: var(--fs-sm); }
  .quote__advice {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-dark);
    max-width: 60ch;
  }
  .quote__advice p { margin-top: 1rem; font-weight: 400; letter-spacing: -0.015em; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.35; color: rgb(255 255 255 / 0.85); }

  /* Communication */
  .talk { display: grid; gap: 2rem; }
  .talk h2 { margin-top: 1.1rem; }
  .talk__body p { color: var(--steel); font-size: var(--fs-lg); max-width: 54ch; }
  .talk__body p + p { margin-top: 1.25rem; }
  .talk__body .btn { margin-top: 2rem; }
  .talk__quote { margin-top: 2rem; padding: 1.5rem 1.75rem; border-left: 3px solid var(--accent); background: var(--paper); border-radius: 0 var(--radius) var(--radius) 0; }
  .talk__quote p { font-size: var(--fs-lg); line-height: 1.5; color: var(--ink); }
  .talk__quote figcaption { margin-top: 0.75rem; font-size: var(--fs-sm); color: var(--steel); }
  .talk__quote a { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 1024px) { .talk { grid-template-columns: 1fr 1.2fr; gap: 5rem; align-items: start; } }

  /* Values */
  .values { display: grid; gap: 1rem; }
  .values li { padding: 2rem; border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--line); }
  .values__num { font-weight: 600; letter-spacing: -0.03em; font-size: 1.5rem; line-height: 1; color: var(--accent); }
  .values h3 { margin-top: 2rem; }
  .values p { margin-top: 0.6rem; color: var(--steel); font-size: var(--fs-sm); }
  @media (min-width: 640px) { .values { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .values { grid-template-columns: repeat(4, 1fr); } }
</style>
