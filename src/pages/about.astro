---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import { business } from "../data/business";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
];

const values = [
  { title: "You'll know where things stand", text: "From the estimate to cleanup, you'll know what's happening and what comes next." },
  { title: "We'll say when a repair is enough", text: "If a repair solves the problem, that's what we recommend instead of a new roof." },
  { title: "We fix what's under the shingles", text: "Soft decking and worn flashing get repaired before the new roof goes on." },
  { title: "Your property stays protected", text: "We protect landscaping, driveways and gutters, and clean up before we leave." },
];
---

<BaseLayout
  title="About GM Roofing | Sacramento Valley Roofing Contractor"
  description="GM Roofing is a family-owned roofing contractor serving the Sacramento Valley. Learn about our approach to roof replacement, repair, and inspections."
  breadcrumbs={breadcrumbs}
  pageType="AboutPage"
>
  <PageHero
    eyebrow="About us"
    title="A family-owned roofer in <em>Sacramento.</em>"
    lede="We replace, repair and inspect roofs for homeowners and businesses across the Sacramento Valley."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container story">
      <p class="story__lead" data-reveal>
        We approach every job the same way: look at the roof honestly, explain what it actually needs, and put it in
        <em>writing</em> before any work starts.
      </p>
      <div class="story__body">
        <p data-reveal>
          {business.name} is a family-owned roofing contractor working with homeowners and businesses across the {business.primaryRegion}. We handle roof replacement, roof repair, tile roofing, inspections and commercial roofing.
        </p>
        <p data-reveal style="--d:1">
          No upselling and no scare tactics. You get straight information so you can make a good decision about your roof.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <SectionHead align="split" eyebrow="Our approach" title="How we <em>work.</em>" />
      <ol role="list" class="values">
        {
          values.map((v, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="values__num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <SectionHead align="split" eyebrow="How we work" title="Four steps, <em>in writing.</em>" />
      <ProcessSteps />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead align="split" eyebrow="Services" title="What we <em>do.</em>" />
      <ServiceGrid exclude={["residential-roofing-sacramento"]} />
    </div>
  </section>
</BaseLayout>

<style>
  .story { display: grid; gap: 2.5rem; }
  .story__lead {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 550;
    max-width: 22ch;
    text-wrap: balance;
  }
  .story__lead em { font-family: var(--font-serif); font-weight: 400; color: var(--accent); }
  .story__body p { color: var(--steel); font-size: var(--fs-lg); max-width: 52ch; }
  .story__body p + p { margin-top: 1.25rem; }
  @media (min-width: 1024px) {
    .story { grid-template-columns: 1.3fr 1fr; gap: 5rem; align-items: end; }
  }

  .values { display: grid; gap: 1rem; }
  .values li { padding: 2rem; border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--line); }
  .values__num { font-family: var(--font-serif); font-style: italic; font-size: 2.25rem; line-height: 1; color: var(--accent); }
  .values h3 { margin-top: 2rem; }
  .values p { margin-top: 0.6rem; color: var(--steel); font-size: var(--fs-sm); }
  @media (min-width: 640px) { .values { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .values { grid-template-columns: repeat(4, 1fr); } }
</style>
