---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import AreaList from "../components/AreaList.astro";
import Icon from "../components/Icon.astro";
import { business } from "../data/business";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Service Areas", href: "/service-areas/" },
];
import { serviceAreasHeroImage } from "../data/images";
---

<BaseLayout
  title="Sacramento Valley Service Areas | GM Roofing"
  description="GM Roofing serves homeowners and businesses across the Sacramento Valley, including Elk Grove, Roseville, Folsom, Fair Oaks, Granite Bay, Arden, Cameron Park, Davis, Woodland, West Sacramento and Citrus Heights."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Service areas"
    title="Where <em>we work.</em>"
    image={serviceAreasHeroImage}
    lede={`${business.name} serves homeowners and businesses across the ${business.primaryRegion}.`}
    cta="Request a free estimate"
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        align="split"
        eyebrow={`${business.cities.length} communities`}
        title="Sacramento Valley communities <em>we serve</em>"
        lede="Don't see your city? Ask anyway. We cover more of the valley than any list can show."
      />
      <AreaList />
    </div>
  </section>

  <section class="section section--paper">
    <div class="container climate">
      <div>
        <span class="eyebrow" data-reveal>Local knowledge</span>
        <h2 data-reveal style="--d:1">Roofing built around the <em>local climate.</em></h2>
      </div>
      <div>
        <p data-reveal style="--d:2">
          Every community in the Sacramento Valley gets the same long, hot summers and occasional heavy winter storms, but roof age and housing stock change block to block.
        </p>
        <p data-reveal style="--d:3">
          Whether you're in an established Sacramento neighborhood or a newer development in Elk Grove or Folsom, we inspect, repair and replace roofs the same careful way.
        </p>
        <a class="btn btn--dark" href="/contact/" data-reveal style="--d:4">Request a free estimate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .climate { display: grid; gap: 2rem; }
  .climate h2 { margin-top: 1.1rem; max-width: 14ch; }
  .climate p { color: var(--steel); font-size: var(--fs-lg); max-width: 54ch; }
  .climate p + p { margin-top: 1.25rem; }
  .climate .btn { margin-top: 2rem; }
  @media (min-width: 1024px) { .climate { grid-template-columns: 1fr 1fr; gap: 5rem; } }
</style>
