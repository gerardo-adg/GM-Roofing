---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import AreaList from "../components/AreaList.astro";
import RoofAnatomy from "../components/RoofAnatomy.astro";
import MuxBackground from "../components/MuxBackground.astro";
import MuxFilm from "../components/MuxFilm.astro";
import Faq from "../components/Faq.astro";
import { business, hasPhone, hoursText } from "../data/business";
import { reviews } from "../data/reviews";
import { projects } from "../data/projects";
import { media, hasClip } from "../data/media";
import { ids } from "../lib/schema";
import { story } from "../data/story";

const heroVideo = hasClip(media.hero);
const anatomy = ["Ridge vent", "Roof covering", "Underlayment", "Roof decking", "Flashing and drip edge"];

const trust = [
  { icon: "family", title: "Family-owned", text: "A local family business, not a franchise or a storm-chasing crew." },
  { icon: "shield", title: "Licensed and insured", text: `CA CSLB #${business.license.number}, C-39 roofing contractor. Bonded and insured.` },
  { icon: "doc", title: "Free written estimates", text: "Scope, materials and price on paper before anything is scheduled." },
  { icon: "clock", title: "Open 7 days", text: hoursText.join(". ") + "." },
];

const repairSigns = [
  "An active leak or a new water stain",
  "A few missing or damaged shingles",
  "Wind or storm damage in one area",
  "Flashing pulling away at a chimney, vent or skylight",
  "Cracked or slipped tiles",
];
const replaceSigns = [
  "Shingles curling, cracking or missing across the roof",
  "Granules collecting in gutters and downspouts",
  "Soft spots in the decking or a sagging roofline",
  "New leaks after earlier repairs",
  "Storm damage across most of the roof",
];

const values = [
  { title: "Easy to reach, easy to talk to", text: "From the estimate to cleanup, you'll know what's happening and what comes next, in plain language." },
  { title: "We'll say when a repair is enough", text: "If a repair solves the problem, that's what we recommend. We don't sell roofs people don't need." },
  { title: "We fix what's under the shingles", text: "Soft decking and worn flashing get repaired before the new roof goes on, not covered up." },
  { title: "Your property stays protected", text: "We protect landscaping, driveways and gutters while we work, and clean up before we leave." },
];

const climate = [
  { icon: "sun", title: "Long, hot summers", text: "Months of high heat and sun dry out shingles and age underlayment faster than in milder climates." },
  { icon: "rain", title: "Winter storms", text: "Wind and heavy rain find every weak spot in flashing, valleys and worn roofing." },
  { icon: "home", title: "Older housing stock", text: "Many established neighborhoods have roofs reaching the end of their service life." },
];

const faqs = [
  {
    q: "Should I repair or replace my roof?",
    a: "Repair usually makes sense when damage is limited to one area and the rest of the roof is in good shape. Replacement makes more sense when repairs keep coming, damage is spread across the roof or the decking underneath is failing. We inspect the roof in person and give you our recommendation in writing.",
  },
  {
    q: "How much does a new roof cost in Sacramento?",
    a: "Price depends on the roof's size and pitch, the material, how many layers come off, decking repairs and permits. We don't quote from the street or over the phone. After an inspection you get a free written estimate with the full scope and price.",
  },
  {
    q: "How long does a roof replacement take?",
    a: "Many single-family shingle replacements take a few days on site. Tile, larger homes, decking repairs and weather can add time. Your estimate includes a timeline for your roof.",
  },
  {
    q: "Do I need a permit to replace a roof in Sacramento?",
    a: "In California, reroofing generally requires a building permit from your city or county, and the work is inspected. We'll go over what applies to your property with your estimate.",
  },
  {
    q: "My tile roof is leaking but the tiles look fine. Why?",
    a: "Tile sheds most of the water, but the underlayment beneath it keeps it out of the house. Years of Sacramento heat can dry that layer out and crack it even when the tile on top looks perfect. Often the tile can be lifted, the underlayment replaced and the original tile reset.",
  },
  {
    q: "What areas do you serve?",
    a: `${business.name} serves ${business.cities.slice(0, -1).join(", ")} and ${business.cities.at(-1)}, plus nearby Sacramento Valley communities.`,
  },
];

const videos = [
  ...(heroVideo ? [{ key: "hero", clip: media.hero }] : []),
  ...(hasClip(media.projectFilm) ? [{ key: "film", clip: media.projectFilm }] : []),
];
---

<BaseLayout
  title="Roof Replacement & Roof Repair in Sacramento, CA | GM Roofing"
  description="GM Roofing is a family-owned Sacramento roofer for roof replacement, roof repair, tile roofing and inspections. Free written estimates across the Sacramento Valley."
  about={ids.business}
  faqs={faqs}
  videos={videos}
>
  <!-- ============ HERO ============ -->
  <section class:list={["hero on-dark", { "hero--video": heroVideo }]}>
    {
      heroVideo ? (
        <div class="hero__media">
          <MuxBackground clip={media.hero} mobileClip={media.heroMobile} eager maxResolution="1440p" />
          <div class="hero__shade" />
        </div>
      ) : (
        <div class="hero__bg" aria-hidden="true" />
      )
    }
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow" data-reveal>Family-owned · {business.primaryRegion}</span>
        <h1 data-reveal="lines">
          <span class="l"><span class="l__in">Roof replacement</span></span>
          <span class="l"><span class="l__in">and repair in</span></span>
          <span class="l"><span class="l__in"><em>Sacramento.</em></span></span>
        </h1>
        <p class="lede" data-reveal style="--d:4">
          We replace and repair shingle and tile roofs across the Sacramento Valley. Every job starts with an in-person inspection and a written estimate, so you know the scope and price before anything is scheduled.
        </p>
        <div class="btn-row" data-reveal style="--d:5">
          <a class="btn btn--accent" href="/contact/">Request a free estimate <Icon name="arrow" class="arrow" /></a>
          {
            hasPhone ? (
              <a class="btn btn--ghost" href={`tel:${business.phone.tel}`}><Icon name="phone" /> {business.phone.display}</a>
            ) : (
              <a class="btn btn--ghost" href="#services">See our services</a>
            )
          }
        </div>
        <ul role="list" class="hero__checks" data-reveal style="--d:6">
          <li><Icon name="check" size={18} /> Free written estimates</li>
          <li><Icon name="check" size={18} /> Licensed, bonded and insured</li>
          <li><Icon name="check" size={18} /> Open 7 days a week</li>
        </ul>
      </div>

      {
        !heroVideo && (
          <div class="hero__visual">
            <figure class="anatomy" data-reveal style="--d:2">
              <figcaption class="anatomy__head">
                <span>Anatomy of a roof</span>
                <span class="anatomy__tag">We check every layer</span>
              </figcaption>
              <div class="anatomy__art" data-reveal="draw"><RoofAnatomy /></div>
              <ol role="list" class="anatomy__legend" data-stagger>
                {anatomy.map((a, i) => <li data-reveal style="--d:8"><span>{i + 1}</span>{a}</li>)}
              </ol>
            </figure>
            <div class="hero__badge" data-reveal style="--d:10">
              <span class="hero__badge-icon"><Icon name="doc" size={22} /></span>
              <span><strong>Written estimate</strong> before any work begins</span>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ============ TRUST ============ -->
  <section class="trust" aria-label="Why homeowners work with us">
    <div class="container">
      <ul role="list" class="trust__grid" data-stagger>
        {
          trust.map((t) => (
            <li data-reveal>
              <span class="trust__icon"><Icon name={t.icon} size={22} /></span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section--paper" id="services">
    <div class="container">
      <SectionHead
        align="split"
        eyebrow="Services"
        title="Roofing services across the <em>Sacramento Valley</em>"
        lede="One small repair or a full tear-off, every job starts the same way: we look at the roof in person and put our recommendation in writing."
      />
      <ServiceGrid exclude={["residential-roofing-sacramento"]} />
    </div>
  </section>

  <!-- ============ REPAIR VS REPLACE ============ -->
  <section class="section">
    <div class="container">
      <SectionHead
        align="split"
        eyebrow="Repair or replace?"
        title="Plenty of roofs only need <em>a repair.</em>"
        lede="Here's how we tell the difference. If you're not sure which side your roof is on, start with an inspection."
      />
      <div class="rr" data-stagger>
        <article class="rr__card" data-reveal>
          <div class="rr__head">
            <span class="rr__icon"><Icon name="repair" size={24} /></span>
            <div>
              <span class="rr__kicker">Usually a repair</span>
              <h3>Fix it before it spreads</h3>
            </div>
          </div>
          <p>Most repairs start small: a leak after a storm, a few missing shingles, flashing that's pulled loose. Caught early, they stay small. Left alone, water reaches the decking and the ceiling below.</p>
          <ul role="list" class="rr__list">
            {repairSigns.map((s) => <li><Icon name="check" size={18} />{s}</li>)}
          </ul>
          <a class="text-link" href="/roof-repair-sacramento/">Roof repair in Sacramento <Icon name="arrow" /></a>
        </article>
        <article class="rr__card rr__card--dark on-dark" data-reveal>
          <div class="rr__head">
            <span class="rr__icon"><Icon name="replacement" size={24} /></span>
            <div>
              <span class="rr__kicker">Time for a new roof</span>
              <h3>When patching stops working</h3>
            </div>
          </div>
          <p>When a roof is past the point of patching, we'll tell you, and walk you through materials, timeline and cost before you commit to anything.</p>
          <ul role="list" class="rr__list">
            {replaceSigns.map((s) => <li><Icon name="check" size={18} />{s}</li>)}
          </ul>
          <a class="text-link" href="/roof-replacement-sacramento/">Roof replacement in Sacramento <Icon name="arrow" /></a>
        </article>
      </div>
      <div class="rr__foot" data-reveal>
        <p><strong>Not sure what your roof needs?</strong> An inspection tells you whether a repair will hold or it's time to replace.</p>
        <a class="btn btn--dark" href="/roof-inspections-sacramento/">About inspections <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED FILM (once a Mux ID is added) ============ -->
  {
    hasClip(media.projectFilm) && (
      <section class="section section--dark">
        <div class="container">
          <SectionHead align="split" eyebrow="On the job" title="Watch a Sacramento <em>roof replacement.</em>" lede={media.projectFilm.description} />
          <div data-reveal="media"><MuxFilm clip={media.projectFilm} /></div>
        </div>
      </section>
    )
  }

  <!-- ============ HOW WE WORK ============ -->
  <section class="section section--paper">
    <div class="container why">
      <div class="why__intro">
        <span class="eyebrow" data-reveal>Why {business.name}</span>
        <h2 data-reveal="lines"><span class="l"><span class="l__in">What working</span></span><span class="l"><span class="l__in">with us <em>looks like.</em></span></span></h2>
        <p class="lede" data-reveal style="--d:2">
          {story.short} No upselling and no scare tactics, just straight information so you can make a good call about your roof.
        </p>
        <a class="text-link" href="/about/" data-reveal style="--d:3">Read our story <Icon name="arrow" /></a>
      </div>
      <ol role="list" class="why__list" data-stagger>
        {
          values.map((v, i) => (
            <li data-reveal>
              <span class="why__num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section section--dark">
    <div class="container">
      <SectionHead
        align="split"
        eyebrow="Our process"
        title="How a project <em>works.</em>"
        lede="Four steps, and you'll know where things stand at each one."
      />
      <ProcessSteps />
    </div>
  </section>

  <!-- ============ LOCAL ============ -->
  <section class="section">
    <div class="container local">
      <div class="local__copy">
        <span class="eyebrow" data-reveal>Local roofing</span>
        <h2 data-reveal="lines"><span class="l"><span class="l__in">Built for</span></span><span class="l"><span class="l__in"><em>valley weather.</em></span></span></h2>
        <p data-reveal style="--d:2">
          Sacramento Valley roofs take a specific kind of beating, and it shows on shingles, tile and flashing.
        </p>
        <p data-reveal style="--d:3">
          We focus on roof replacement, roof repair and inspections in and around Sacramento because it's the work we know best. Whether it's a slow leak, a replacement you're planning for or a second opinion, you'll be talking to a local roofer you can actually reach.
        </p>
      </div>
      <ul role="list" class="local__list" data-stagger>
        {
          climate.map((c) => (
            <li data-reveal>
              <span class="local__icon"><Icon name={c.icon} size={24} /></span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PROJECTS (once Mux clips are added) ============ -->
  {
    projects.length > 0 && (
      <section class="section section--paper">
        <div class="container">
          <SectionHead align="split" eyebrow="Recent work" title="Roofs we've <em>finished.</em>" />
          <ul role="list" class="gallery">
            {projects.map((p, i) => (
              <li>
                <figure class="gallery__item" data-reveal="media" style={`--d:${i % 3}`}>
                  <div class="gallery__media">
                    <MuxBackground
                      clip={{ playbackId: p.playbackId, title: p.title, description: p.alt, uploadDate: "", posterTime: p.posterTime }}
                    />
                  </div>
                  <figcaption>
                    <strong>{p.title}</strong>
                    {p.location && <span>{p.location}</span>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ REVIEWS (once real reviews are added) ============ -->
  {
    reviews.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHead eyebrow="Reviews" title="What homeowners <em>say</em>" />
          <ul role="list" class="reviews" data-stagger>
            {reviews.map((r) => (
              <li data-reveal>
                <blockquote>
                  <p>“{r.quote}”</p>
                  <footer>
                    <strong>{r.name}</strong>
                    {r.location && <span> · {r.location}</span>}
                    {r.source && <span class="reviews__src">{r.source}</span>}
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ FAQ ============ -->
  <section class="section section--paper">
    <div class="container faqwrap">
      <div>
        <span class="eyebrow" data-reveal>Questions</span>
        <h2 data-reveal="lines"><span class="l"><span class="l__in">Roofing questions</span></span><span class="l"><span class="l__in">we hear <em>every week.</em></span></span></h2>
        <p class="lede" data-reveal style="--d:2">Don't see yours? Ask us when you request an estimate.</p>
      </div>
      <div data-reveal style="--d:2"><Faq items={faqs} /></div>
    </div>
  </section>

  <!-- ============ SERVICE AREAS ============ -->
  <section class="section">
    <div class="container">
      <SectionHead
        align="split"
        eyebrow="Where we work"
        title="Sacramento and <em>nearby cities</em>"
        lede="Homes and businesses across the region, including these communities. Don't see yours? Ask anyway."
      />
      <AreaList />
      <div class="areas-foot" data-reveal>
        <a class="btn btn--outline" href="/service-areas/">All service areas <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 5.5rem));
    padding-bottom: clamp(7rem, 12vw, 10rem);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(160deg, var(--navy) 0%, var(--ink) 60%);
  }
  .hero__bg::after {
    /* fine blueprint grid */
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 90%);
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(10 26 43 / 0.82) 0%, rgb(10 26 43 / 0.4) 65%, rgb(10 26 43 / 0.15) 100%),
      linear-gradient(0deg, rgb(10 26 43 / 0.75) 0%, transparent 45%);
  }
  .hero__grid { display: grid; gap: clamp(3rem, 6vw, 4rem); align-items: center; }
  .hero h1 { margin-top: 1.5rem; }
  .hero .lede { margin-top: 1.75rem; max-width: 50ch; }
  .hero .btn-row { margin-top: 2.5rem; }
  .hero__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.75);
  }
  .hero__checks li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .hero__checks :global(svg) { color: var(--accent-soft); }

  .hero__visual { position: relative; }
  .anatomy {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .anatomy__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }
  .anatomy__tag {
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    border: 1px solid rgb(51 189 249 / 0.35);
    color: var(--accent-soft);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .anatomy__art { margin-block: 1rem 0.5rem; }
  .anatomy__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.78);
  }
  .anatomy__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem 0.3rem 0.3rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.06);
  }
  .anatomy__legend span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: var(--ink);
    border: 1px solid rgb(255 255 255 / 0.35);
    font-size: 10px;
    font-weight: 600;
  }
  .hero__badge {
    position: absolute;
    left: -2.5rem;
    top: 24%;
    display: none;
    align-items: center;
    gap: 0.85rem;
    max-width: 260px;
    padding: 1rem 1.25rem 1rem 1rem;
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow);
    font-size: var(--fs-sm);
    line-height: 1.35;
  }
  .hero__badge-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--paper);
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .hero { min-height: 100svh; display: flex; align-items: center; }
    .hero__grid { grid-template-columns: 1.15fr 1fr; gap: 4rem; }
    .hero--video .hero__grid { grid-template-columns: minmax(0, 760px); }
    .hero__badge { display: flex; }
  }

  /* Subtle parallax on the hero art/video, in browsers with scroll-driven animations */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__visual, .hero__media {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      @keyframes hero-drift { to { transform: translate3d(0, 12vh, 0); } }
    }
  }

  /* ---------- Trust ---------- */
  .trust { position: relative; z-index: 2; margin-top: clamp(-5rem, -8vw, -4rem); }
  .trust__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .trust__grid li { padding: clamp(1.25rem, 3vw, 2.25rem); border-bottom: 1px solid var(--line); }
  .trust__grid li:nth-child(odd) { border-right: 1px solid var(--line); }
  .trust__grid li:nth-last-child(-n + 2) { border-bottom: 0; }
  .trust__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--paper);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .trust h3 { font-size: 1.125rem; }
  .trust p { margin-top: 0.4rem; font-size: var(--fs-sm); color: var(--steel); line-height: 1.55; }
  @media (max-width: 639px) {
    .trust h3 { font-size: 1rem; }
    .trust p { font-size: var(--fs-xs); }
    .trust__icon { width: 38px; height: 38px; margin-bottom: 1rem; }
  }
  @media (min-width: 1024px) {
    .trust__grid { grid-template-columns: repeat(4, 1fr); }
    .trust__grid li { border-bottom: 0; border-right: 1px solid var(--line); }
    .trust__grid li:last-child { border-right: 0; }
  }
  .trust + .section--paper { margin-top: calc(var(--section) * -0.5); padding-top: calc(var(--section) * 1.5); }

  /* ---------- Repair vs replace ---------- */
  .rr { display: grid; gap: 1rem; }
  .rr__card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .rr__card > p { color: var(--steel); }
  .rr__card--dark { background: linear-gradient(170deg, var(--navy) 0%, var(--ink) 70%); color: var(--white); }
  .rr__card--dark > p { color: rgb(255 255 255 / 0.7); }
  .rr__head { display: flex; gap: 1rem; align-items: flex-start; }
  .rr__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--white);
    color: var(--accent);
  }
  .rr__card--dark .rr__icon { background: rgb(255 255 255 / 0.08); color: var(--accent-soft); }
