---
/**
 * Silent looping background video from Mux.
 *
 * Loading strategy (keeps pages fast):
 *  1. The poster still renders immediately as a normal responsive <img>,
 *     so it's what the browser paints first (good LCP).
 *  2. The ~4 KB video engine is only downloaded once the block is near the
 *     viewport, and never for visitors with reduced motion or data saver on.
 *  3. Phones get a 720p cap (and the vertical cut if one is provided);
 *     larger screens get 1080p, or 1440p for the hero.
 *  4. The video fades in over the poster once it's actually playing, and
 *     pauses whenever it scrolls off screen.
 */
import MuxImage from "./MuxImage.astro";
import { muxStream, type MuxClip } from "../data/media";

interface Props {
  clip: MuxClip;
  mobileClip?: MuxClip;
  eager?: boolean;
  /** Max resolution on large screens. */
  maxResolution?: "1080p" | "1440p" | "2160p";
  /** Max resolution on phones (default 720p). */
  maxResolutionMobile?: "720p" | "1080p";
  class?: string;
}
const { clip, mobileClip, eager = false, maxResolution = "1080p", maxResolutionMobile = "720p", class: className } = Astro.props;
const mobileId = mobileClip?.playbackId || clip.playbackId;
---

<div
  class:list={["mbg", className]}
  data-mux-bg
  data-src={muxStream(clip.playbackId)}
  data-plus={clip.quality === "plus" ? "" : undefined}
  data-src-mobile={muxStream(mobileId)}
  data-max={maxResolution}
  data-max-mobile={maxResolutionMobile}
  data-start={clip.posterTime ?? 0}
  data-start-mobile={(mobileClip?.playbackId ? mobileClip.posterTime : clip.posterTime) ?? 0}
  data-eager={eager ? "" : undefined}
>
  <picture class="mbg__poster">
    {
      mobileClip?.playbackId && (
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={`https://image.mux.com/${mobileId}/thumbnail.webp?time=${mobileClip.posterTime ?? 1}&width=480 480w, https://image.mux.com/${mobileId}/thumbnail.webp?time=${mobileClip.posterTime ?? 1}&width=900 900w, https://image.mux.com/${mobileId}/thumbnail.webp?time=${mobileClip.posterTime ?? 1}&width=1200 1200w`}
          sizes="100vw"
        />
      )
    }
    <MuxImage playbackId={clip.playbackId} time={clip.posterTime} alt="" eager={eager} />
  </picture>
  <script is:inline>
    // Fade the still in when it arrives instead of letting it pop in over the dark background
    (function (img) {
      if (!img) return;
      if (img.complete && img.naturalWidth) img.classList.add("is-loaded");
      else img.addEventListener("load", function () { img.classList.add("is-loaded"); }, { once: true });
    })(document.currentScript.previousElementSibling.querySelector("img"));
  </script>
</div>

<style>
  /* isolation keeps the still and video layers inside this box, under any overlay on top */
  .mbg { position: absolute; inset: 0; overflow: hidden; background: var(--ink); isolation: isolate; }
  .mbg__poster, .mbg :global(img), .mbg :global(.bgv) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The video sits underneath at full opacity and the still fades away on
     top once real frames are playing. Fading the video element itself makes
     Safari pulse in brightness as it switches how it draws the video. */
  /* Keep the video invisible until real frames are playing. Before that,
     iPhones draw their own big play button on top of a paused video. */
  .mbg :global(.bgv) { display: block; z-index: 0; visibility: hidden; }
  .mbg :global(.bgv.is-playing) { visibility: visible; }
  .mbg :global(.bgv::-webkit-media-controls),
  .mbg :global(.bgv::-webkit-media-controls-start-playback-button),
  .mbg :global(.bgv::-webkit-media-controls-overlay-play-button) { display: none !important; -webkit-appearance: none; }
  .mbg__poster { z-index: 1; transition: opacity 0.8s var(--ease); }
  .mbg:has(:global(.bgv.is-playing)):not(.is-switching) .mbg__poster { opacity: 0; }
  :global(.js) .mbg__poster :global(img) { opacity: 0; transition: opacity 0.6s var(--ease); }
  :global(.js) .mbg__poster :global(img.is-loaded) { opacity: 1; }
</style>

<script>
  import { mountBgVideo, preloadEngine, preloadHls, type BgVideo } from "../scripts/bgvideo";

  const blocks = document.querySelectorAll<HTMLElement>("[data-mux-bg]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (blocks.length && !reduce && !saveData) {
    const phone = window.matchMedia("(max-width: 767px)");
    const players = new Map<HTMLElement, BgVideo>();
    const visible = new Map<HTMLElement, boolean>();

    const mount = async (block: HTMLElement) => {
      const mobile = phone.matches;
      const src = (mobile ? block.dataset.srcMobile : block.dataset.src) ?? "";
      const player: BgVideo = await mountBgVideo(block, src, mobile ? block.dataset.maxMobile ?? "720p" : block.dataset.max ?? "1080p", {
        plus: block.hasAttribute("data-plus"),
        // Start on the poster's frame so the still-to-video handoff is seamless
        startAt: Number((mobile ? block.dataset.startMobile : block.dataset.start) ?? 0),
      });
      players.set(block, player);
      if (visible.get(block) === false) player.pause();
    };

    // Pause when off screen to save battery and bandwidth.
    const setVisible = (block: HTMLElement, on: boolean) => {
      visible.set(block, on);
      const p = players.get(block);
      if (p) on ? p.play() : p.pause();
    };
    const visibility = new IntersectionObserver((entries) => {
      for (const e of entries) setVisible(e.target as HTMLElement, e.isIntersecting);
    });

    // Crossing the phone/desktop breakpoint (rotating a tablet, resizing a
    // window): swap to the right cut. The still for the new size fades in
    // over the old video first, then the new video takes over underneath.
    phone.addEventListener("change", () => {
      players.forEach((player, block) => {
        if (block.dataset.src === block.dataset.srcMobile) return;
        block.classList.add("is-switching");
        players.delete(block);
        window.setTimeout(async () => {
          player.destroy();
          await mount(block);
          const v = block.querySelector(".bgv");
          const done = () => block.classList.remove("is-switching");
          if (!v) return done();
          new MutationObserver((_, mo) => {
            if (v.classList.contains("is-playing")) { mo.disconnect(); done(); }
          }).observe(v, { attributes: true, attributeFilter: ["class"] });
        }, 800);
      });
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          visibility.observe(e.target);
          mount(e.target as HTMLElement);
        }
      },
      { rootMargin: "200px 0px" }
    );

    // Above-the-fold videos (the hero) start right away; the rest wait
    // until the page and its images have loaded.
    const eager = [...blocks].filter((b) => b.hasAttribute("data-eager"));
    const lazy = [...blocks].filter((b) => !b.hasAttribute("data-eager"));
    if (eager.length) {
      if (eager.some((b) => b.hasAttribute("data-plus"))) preloadHls();
      else preloadEngine();
      eager.forEach((b) => io.observe(b));
    }
    const start = () => {
      preloadEngine();
      lazy.forEach((b) => io.observe(b));
    };
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
