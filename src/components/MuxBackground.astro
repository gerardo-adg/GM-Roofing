---
/**
 * Silent looping background video from Mux.
 *
 * Loading strategy (keeps pages fast):
 *  1. The poster still renders immediately as a normal responsive <img>,
 *     so it's what the browser paints first (good LCP).
 *  2. The ~4 KB video engine is only downloaded once the block is near the
 *     viewport, and never for visitors with reduced motion or data saver on.
 *  3. Phones get a 720p cap (and the vertical cut if one is provided);
 *     larger screens get 1080p, or 1440p for the hero.
 *  4. The video fades in over the poster once it's actually playing, and
 *     pauses whenever it scrolls off screen.
 */
import MuxImage from "./MuxImage.astro";
import { muxStream, type MuxClip } from "../data/media";

interface Props {
  clip: MuxClip;
  mobileClip?: MuxClip;
  eager?: boolean;
  /** Max resolution on large screens. */
  maxResolution?: "1080p" | "1440p" | "2160p";
  /**
   * Skip the still and fade the video up from the dark background instead.
   * Safari renders a still and a video frame with slightly different color,
   * so swapping one for the other reads as a brightness flicker. The still
   * is kept only for visitors who won't get the video (reduced motion).
   */
  noPoster?: boolean;
  class?: string;
}
const { clip, mobileClip, eager = false, maxResolution = "1080p", noPoster = false, class: className } = Astro.props;
const mobileId = mobileClip?.playbackId || clip.playbackId;
---

<div
  class:list={["mbg", { "mbg--noposter": noPoster }, className]}
  data-mux-bg
  data-src={muxStream(clip.playbackId)}
  data-plus={clip.quality === "plus" ? "" : undefined}
  data-src-mobile={muxStream(mobileId)}
  data-max={maxResolution}
  data-start={Math.max(clip.posterTime ?? 0, clip.trimStart ?? 0)}
  data-start-mobile={(mobileClip?.playbackId ? Math.max(mobileClip.posterTime ?? 0, mobileClip.trimStart ?? 0) : Math.max(clip.posterTime ?? 0, clip.trimStart ?? 0))}
  data-trim={clip.trimStart ?? 0}
  data-trim-mobile={(mobileClip?.playbackId ? mobileClip.trimStart : clip.trimStart) ?? 0}
  data-eager={eager ? "" : undefined}
>
  <picture class="mbg__poster">
    {
      mobileClip?.playbackId && (
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={`https://image.mux.com/${mobileId}/thumbnail.webp?time=${mobileClip.posterTime ?? 1}&width=480 480w, https://image.mux.com/${mobileId}/thumbnail.webp?time=${mobileClip.posterTime ?? 1}&width=900 900w`}
          sizes="100vw"
        />
      )
    }
    <MuxImage playbackId={clip.playbackId} time={clip.posterTime} alt="" eager={eager && !noPoster} />
  </picture>
  {noPoster && <div class="mbg__cover" />}
  <script is:inline>
    // Fade the still in when it arrives instead of letting it pop in over the dark background
    (function (img) {
      if (!img) return;
      if (img.complete && img.naturalWidth) img.classList.add("is-loaded");
      else img.addEventListener("load", function () { img.classList.add("is-loaded"); }, { once: true });
    })(document.currentScript.previousElementSibling.querySelector("img"));
  </script>
</div>

<style>
  .mbg { position: absolute; inset: 0; overflow: hidden; background: var(--ink); }
  .mbg__poster, .mbg :global(img), .mbg :global(.bgv) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The video sits underneath at full opacity and the still fades away on
     top once real frames are playing. Fading the video element itself makes
     Safari pulse in brightness as it switches how it draws the video. */
  .mbg :global(.bgv) { display: block; z-index: 0; }
  .mbg__poster { z-index: 1; transition: opacity 0.8s var(--ease); }
  .mbg:has(:global(.bgv.is-playing)) .mbg__poster { opacity: 0; }
  /* No-poster mode: a cover in the background color lifts off the video */
  .mbg__cover { position: absolute; inset: 0; z-index: 1; background: inherit; transition: opacity 0.9s var(--ease); }
  .mbg:has(:global(.bgv.is-playing)) .mbg__cover { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mbg--noposter .mbg__poster { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbg__cover { display: none; }
  }
  :global(.js) .mbg__poster :global(img) { opacity: 0; transition: opacity 0.6s var(--ease); }
  :global(.js) .mbg__poster :global(img.is-loaded) { opacity: 1; }
</style>

<script>
  import { mountBgVideo, preloadEngine, preloadHls, type BgVideo } from "../scripts/bgvideo";

  const blocks = document.querySelectorAll<HTMLElement>("[data-mux-bg]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (blocks.length && !reduce && !saveData) {
    const mount = async (block: HTMLElement) => {
      const mobile = window.matchMedia("(max-width: 767px)").matches;
      const src = (mobile ? block.dataset.srcMobile : block.dataset.src) ?? "";
      const player: BgVideo = await mountBgVideo(block, src, mobile ? "720p" : block.dataset.max ?? "1080p", {
        plus: block.hasAttribute("data-plus"),
        // Start on the poster's frame so the still-to-video handoff is seamless
        startAt: Number((mobile ? block.dataset.startMobile : block.dataset.start) ?? 0),
        loopFrom: Number((mobile ? block.dataset.trimMobile : block.dataset.trim) ?? 0),
      });
      // Pause when off screen to save battery and bandwidth.
      new IntersectionObserver(([e]) => (e.isIntersecting ? player.play() : player.pause())).observe(block);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          mount(e.target as HTMLElement);
        }
      },
      { rootMargin: "200px 0px" }
    );

    // Above-the-fold videos (the hero) start right away; the rest wait
    // until the page and its images have loaded.
    const eager = [...blocks].filter((b) => b.hasAttribute("data-eager"));
    const lazy = [...blocks].filter((b) => !b.hasAttribute("data-eager"));
    if (eager.length) {
      if (eager.some((b) => b.hasAttribute("data-plus"))) preloadHls();
      else preloadEngine();
      eager.forEach((b) => io.observe(b));
    }
    const start = () => {
      preloadEngine();
      lazy.forEach((b) => io.observe(b));
    };
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
