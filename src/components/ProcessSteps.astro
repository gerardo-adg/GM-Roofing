---
import { business } from "../data/business";
---

<ol role="list" class="steps">
  {
    business.process.map((p, i) => (
      <li class="step" data-reveal style={`--d:${i}`}>
        <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
        <h3>{p.step}</h3>
        <p>{p.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps { display: grid; gap: 0; counter-reset: s; }
  .step {
    position: relative;
    padding: 2rem 0 2rem 4.25rem;
    border-top: 1px solid var(--line-dark);
  }
  .step__num {
    position: absolute;
    left: 0;
    top: 2rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--accent-soft);
  }
  .step h3 { font-size: var(--fs-xl); }
  .step p { margin-top: 0.75rem; color: rgb(255 255 255 / 0.66); font-size: var(--fs-sm); max-width: 40ch; }

  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
    .step { padding: 0; border-top: 0; }
    .step__num { position: static; margin-bottom: 2.25rem; }
    .step::before {
      content: "";
      position: absolute;
      top: 22px;
      left: 60px;
      right: -2rem;
      height: 1px;
      background: linear-gradient(90deg, rgb(255 255 255 / 0.25), rgb(255 255 255 / 0.05));
    }
    .step:last-child::before { display: none; }
  }
</style>
