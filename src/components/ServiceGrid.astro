---
/**
 * Service cards. When a service has a Mux clip (media.services[slug]),
 * the card gets a still from it, and on hover-capable devices the clip
 * plays while the pointer is over the card.
 */
import Icon from "./Icon.astro";
import MuxImage from "./MuxImage.astro";
import { services } from "../data/services";
import { media, hasClip, muxStream } from "../data/media";
import { serviceCardImage } from "../data/images";
import { Picture } from "astro:assets";

interface Props {
  exclude?: string[];
}
const { exclude = [] } = Astro.props;
const list = services.filter((s) => !exclude.includes(s.slug));
---

<ul role="list" class="sgrid">
  {
    list.map((s, i) => (
      <li data-reveal style={`--d:${i % 3}`}>
        <a href={`/${s.slug}/`} class:list={["scard", { "scard--media": hasClip(media.services[s.slug]) || serviceCardImage(s.slug) }]}>
          {!hasClip(media.services[s.slug]) && serviceCardImage(s.slug) && (
            <div class="scard__media">
              <Picture
                src={serviceCardImage(s.slug)!.src}
                alt=""
                formats={["avif", "webp"]}
                widths={[480, 800, 1100]}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                style={serviceCardImage(s.slug)!.position ? `object-position:${serviceCardImage(s.slug)!.position}` : undefined}
              />
            </div>
          )}
          {hasClip(media.services[s.slug]) && (
            <div class="scard__media" data-hover-video={muxStream(media.services[s.slug].playbackId)}>
              <MuxImage
                playbackId={media.services[s.slug].playbackId}
                time={media.services[s.slug].posterTime}
                alt=""
                ratio={[4, 3]}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
              />
            </div>
          )}
          <div class="scard__top">
            <span class="scard__icon"><Icon name={s.icon} size={26} /></span>
            <span class="scard__num">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3>{s.name}</h3>
          <p>{s.summary}</p>
          <span class="scard__more">
            Learn more
            <span class="scard__arrow"><Icon name="arrow-up-right" size={18} /></span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .sgrid { display: grid; gap: 1rem; }
  .scard__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin: calc(-1 * clamp(1.5rem, 3vw, 2.25rem)) calc(-1 * clamp(1.5rem, 3vw, 2.25rem)) 1.5rem;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--ink);
  }
  .scard__media :global(img), .scard__media :global(.bgv) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease), opacity 0.6s var(--ease);
  }
  .scard__media :global(.bgv) { opacity: 0; }
  .scard__media :global(.bgv.is-playing) { opacity: 1; }
  .scard:hover .scard__media :global(img) { transform: scale(1.04); }
  .scard--media .scard__top { position: absolute; top: 1rem; left: 1rem; right: 1rem; margin: 0; }
  .scard--media .scard__icon { width: 44px; height: 44px; border-radius: 10px; background: rgb(255 255 255 / 0.92); }
  .scard--media .scard__num { color: rgb(255 255 255 / 0.85); }
  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  .scard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  .scard__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .scard__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--paper);
    color: var(--accent);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }
  .scard:hover .scard__icon { background: var(--ink); color: var(--accent-soft); }
  .scard__num { font-size: var(--fs-xs); color: var(--steel); font-variant-numeric: tabular-nums; letter-spacing: 0.06em; }
  .scard h3 { font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem); }
  .scard p { margin-top: 0.75rem; color: var(--steel); font-size: var(--fs-sm); line-height: 1.6; flex: 1; }
  .scard__more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: 550;
  }
  .scard__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--line);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), transform 0.4s var(--ease), border-color 0.4s;
  }
  .scard:hover .scard__arrow { background: var(--accent); border-color: var(--accent); color: var(--white); transform: rotate(45deg); }

  @media (min-width: 640px) { .sgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sgrid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
</style>

<script>
  // Hover-to-play on devices with a real pointer.
  import { mountBgVideo, preloadEngine, type BgVideo } from "../scripts/bgvideo";

  const boxes = document.querySelectorAll<HTMLElement>("[data-hover-video]");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (boxes.length && canHover && !reduce) {
    window.addEventListener("load", () => preloadEngine(), { once: true });
    boxes.forEach((box) => {
      const card = box.closest("a");
      let player: Promise<BgVideo> | null = null;
      card?.addEventListener("mouseenter", () => {
        if (!player) player = mountBgVideo(box, box.dataset.hoverVideo ?? "", "720p");
        else player.then((v) => v.play());
      });
      card?.addEventListener("mouseleave", () => player?.then((v) => v.pause()));
    });
  }
</script>
