---
/**
 * Customer reviews carousel (scroll-snap, swipe on phones, arrow buttons on
 * desktop). Quotes are shown exactly as written on Yelp.
 */
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import { reviews, reviewsUrl } from "../data/reviews";
---

<section class="section section--dark reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews__head">
      <SectionHead
        id="reviews-title"
        eyebrow="Reviews"
        title="What homeowners <em>say.</em>"
        lede="Real reviews from GM Roofing customers on Yelp."
      />
      <div class="reviews__nav" data-reveal>
        <button type="button" class="reviews__btn" data-rev-prev aria-label="Previous reviews">
          <Icon name="arrow" size={20} class="flip" />
        </button>
        <button type="button" class="reviews__btn" data-rev-next aria-label="Next reviews">
          <Icon name="arrow" size={20} />
        </button>
      </div>
    </div>

    <ul role="list" class="reviews__track" data-rev-track tabindex="0" aria-label="Customer reviews">
      {
        reviews.map((r, i) => (
          <li class="rcard" data-reveal style={`--d:${Math.min(i, 3)}`}>
            <figure>
              <div class="rcard__stars" aria-label={`${r.rating ?? 5} out of 5 stars`}>
                {Array.from({ length: r.rating ?? 5 }).map(() => (
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M10 1.8l2.5 5.1 5.6.8-4 3.9.9 5.6L10 14.6l-5 2.6.9-5.6-4-3.9 5.6-.8z" fill="currentColor" />
                  </svg>
                ))}
              </div>
              <blockquote>
                <p>{r.quote}</p>
              </blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                {r.location && <span>{r.location}</span>}
              </figcaption>
              {r.source && (
                <span class="rcard__src">
                  Review on
                  {r.source === "Yelp" ? (
                    <img src="/brand/yelp-logo.webp" alt="Yelp" width="63" height="24" loading="lazy" decoding="async" />
                  ) : (
                    r.source
                  )}
                </span>
              )}
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="reviews__foot" data-reveal>
      <a class="btn btn--ghost" href={reviewsUrl} target="_blank" rel="noopener">
        Read more reviews on
        <img class="reviews__yelp" src="/brand/yelp-logo-on-dark.webp" alt="Yelp" width="68" height="26" loading="lazy" decoding="async" />
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .reviews { overflow: hidden; }
  .reviews__head { display: grid; gap: 1.5rem; align-items: end; }
  .reviews__head :global(.shead) { margin-bottom: 0; }
  .reviews__nav { display: none; gap: 0.5rem; }
  .reviews__btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: var(--white);
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .reviews__btn:hover:not(:disabled) { background: var(--white); color: var(--ink); }
  .reviews__btn:disabled { opacity: 0.35; cursor: default; }
  .reviews__btn :global(.flip) { transform: rotate(180deg); }
  @media (min-width: 900px) {
    .reviews__head { grid-template-columns: 1fr auto; }
    .reviews__nav { display: flex; }
  }

  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 420px);
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-bottom: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    /* bleed to the right edge of the screen */
    margin-right: calc(-1 * var(--gutter));
    padding-right: var(--gutter);
  }
  .reviews__track::-webkit-scrollbar { display: none; }
  .reviews__track:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: 6px; }
  @media (min-width: 1024px) { .reviews__track { grid-auto-columns: calc((100% - 2rem) / 3); margin-right: 0; padding-right: 0; } }

  .rcard { scroll-snap-align: start; }
  .rcard figure {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink);
  }
  .rcard__stars { display: flex; gap: 0.2rem; color: #e8a317; }
  .rcard blockquote { margin-top: 1.25rem; flex: 1; }
  .rcard blockquote p { font-size: var(--fs-base); line-height: 1.65; color: #263646; }
  .rcard figcaption { margin-top: 1.75rem; }
  .rcard figcaption strong { display: block; font-weight: 650; }
  .rcard figcaption span { display: block; font-size: var(--fs-sm); color: var(--steel); margin-top: 0.15rem; }
  .rcard__src {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--steel);
  }
  .rcard__src img { height: 24px; width: auto; }
  .reviews__yelp { height: 26px; width: auto; margin-block: -6px; }

  .reviews__foot { margin-top: 2.5rem; }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-rev-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-rev-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-rev-next]");
  if (track && prev && next) {
    const step = () => (track.querySelector("li")?.getBoundingClientRect().width ?? 300) + 16;
    const update = () => {
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
