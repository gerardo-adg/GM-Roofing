---
/**
 * Hero illustration: a labelled cross-section of a pitched roof.
 * Pure SVG, generated from a few numbers so it stays crisp at any size.
 * Shown in the homepage hero until a Mux hero video is added (see src/data/media.ts).
 * Strokes draw themselves in when wrapped in [data-reveal="draw"].
 */
const L = { x: 40, y: 360 }; // left eave
const R = { x: 520, y: 360 }; // right eave
const P = { x: 280, y: 130 }; // ridge

// Offset a roof line outward by d (perpendicular to each slope).
const layer = (d: number) => {
  const sx = (P.x - L.x) / Math.hypot(P.x - L.x, P.y - L.y);
  const sy = (P.y - L.y) / Math.hypot(P.x - L.x, P.y - L.y);
  const nx = sy, ny = -sx; // left-slope outward normal
  const lx = L.x + nx * d, ly = L.y + ny * d;
  const rx = R.x - nx * d, ry = R.y + ny * d;
  const py = P.y - d / Math.cos(Math.atan2(L.y - P.y, P.x - L.x));
  return `M${lx.toFixed(1)} ${ly.toFixed(1)} L${P.x} ${py.toFixed(1)} L${rx.toFixed(1)} ${ry.toFixed(1)}`;
};

// Shingle courses: short strokes along both slopes.
const courses: string[] = [];
const steps = 11;
for (let i = 1; i < steps; i++) {
  const t = i / steps;
  for (const side of [-1, 1]) {
    const ex = side < 0 ? L.x : R.x;
    const bx = P.x + (ex - P.x) * t;
    const by = P.y + (L.y - P.y) * t;
    const ang = Math.atan2(L.y - P.y, Math.abs(ex - P.x));
    const nx = side * Math.sin(ang), ny = -Math.cos(ang);
    const x1 = bx + nx * 12, y1 = by + ny * 12;
    const x2 = bx + nx * 22, y2 = by + ny * 22;
    courses.push(`M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`);
  }
}

const markers = [
  { n: 1, x: P.x, y: P.y - 62 },
  { n: 2, x: 402, y: 216 },
  { n: 3, x: 178, y: 214 },
  { n: 4, x: 114, y: 316 },
  { n: 5, x: 536, y: 388 },
];
---

<svg viewBox="0 0 560 470" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <!-- structure -->
  <g stroke="rgb(255 255 255 / .28)" stroke-width="1.25">
    <path d="M60 450h440" pathLength="1" style="--s:0" />
    <path d="M90 360V450M470 360V450M90 360H470" pathLength="1" style="--s:1" />
    <path d={`M${P.x} ${P.y}V360`} stroke-dasharray="3 6" class="pop" style="--s:2" />
    <path d="M150 360 210 300M410 360 350 300" pathLength="1" style="--s:2" />
  </g>
  <!-- decking -->
  <path d={layer(0)} stroke="rgb(255 255 255 / .9)" stroke-width="2.25" pathLength="1" style="--s:3" />
  <!-- underlayment -->
  <path d={layer(7)} stroke="rgb(255 255 255 / .45)" stroke-width="1.25" stroke-dasharray="6 5" class="pop" style="--s:2" />
  <!-- roof covering -->
  <path d={layer(17)} stroke="#e9a26a" stroke-width="2.5" pathLength="1" style="--s:5" />
  <path d={courses.join("")} stroke="#e9a26a" stroke-width="1.25" opacity=".55" class="pop" style="--s:4" />
  <!-- ridge vent -->
  <path d={`M${P.x - 20} ${P.y - 22}h40l-6 -12h-28z`} stroke="#fff" stroke-width="1.5" pathLength="1" style="--s:6" />
  <!-- drip edge -->
  <path d="M28 351l-6 10M532 351l6 10" stroke="#fff" stroke-width="1.5" pathLength="1" style="--s:6" />

  {
    markers.map((m, i) => (
      <g class="pop" style={`--s:${4 + i}`}>
        <circle cx={m.x} cy={m.y} r="12" fill="#0a1a2b" stroke="rgb(255 255 255 / .5)" />
        <text x={m.x} y={m.y + 4} text-anchor="middle" fill="#fff" font-size="11" font-family="Geist Variable, sans-serif" font-weight="600" stroke="none">
          {m.n}
        </text>
      </g>
    ))
  }
</svg>
