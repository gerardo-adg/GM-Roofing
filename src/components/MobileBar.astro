---
/** Sticky bottom action bar on phones — the two things a visitor came to do. */
import Icon from "./Icon.astro";
import { business, hasPhone } from "../data/business";
---

<div class="mbar" data-mbar>
  {
    hasPhone && (
      <a class="mbar__btn mbar__btn--call" href={`tel:${business.phone.tel}`}>
        <Icon name="phone" size={18} /> Call
      </a>
    )
  }
  <a class="mbar__btn mbar__btn--est" href="/contact/">
    Free estimate <Icon name="arrow" size={18} />
  </a>
</div>

<style>
  :global(:root) { --mbar-h: 76px; }
  .mbar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform 0.45s var(--ease);
  }
  .mbar.is-visible { transform: none; }
  .mbar__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    border-radius: 999px;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .mbar__btn--call { flex: 0 0 38%; border: 1px solid rgb(10 26 43 / 0.18); color: var(--ink); }
  .mbar__btn--est { background: var(--accent); color: var(--white); }
  @media (min-width: 768px) {
    .mbar { display: none; }
    :global(:root) { --mbar-h: 0px; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-mbar]");
  if (bar) {
    const update = () => bar.classList.toggle("is-visible", window.scrollY > window.innerHeight * 0.6);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
