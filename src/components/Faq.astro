---
/** FAQ accordion. FAQPage schema is emitted by BaseLayout via its `faqs` prop. */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details class="faq__item">
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a"><p>{f.a}</p></div>
      </details>
    ))
  }
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-lg);
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }
  summary::-webkit-details-marker { display: none; }
  .faq__icon {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--line);
    transition: background-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .faq__icon::before, .faq__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.4s var(--ease);
  }
  .faq__icon::after { rotate: 90deg; }
  .faq__item[open] .faq__icon { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .faq__item[open] .faq__icon::after { rotate: 0deg; }
  summary:hover .faq__icon { border-color: rgb(10 26 43 / 0.3); }
  .faq__a { padding-bottom: 1.5rem; padding-right: 3rem; color: var(--steel); }
  .faq__item[open] .faq__a { animation: faq-in 0.45s var(--ease); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } }
  /* Smooth height animation where supported */
  @supports selector(::details-content) {
    .faq { interpolate-size: allow-keywords; }
    .faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.45s var(--ease), content-visibility 0.45s allow-discrete;
    }
    .faq__item[open]::details-content { block-size: auto; }
  }
</style>
