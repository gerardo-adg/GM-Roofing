---
/**
 * GM Roofing logo. Two versions of the client's mark live in /public/brand:
 * silver-on-transparent for dark backgrounds and navy for light ones.
 * The header swaps between them as it changes from transparent to solid.
 */
import { business } from "../data/business";
interface Props {
  /** "light" = sits on a dark background. */
  tone?: "dark" | "light";
  size?: "md" | "lg";
}
const { tone = "dark", size = "md" } = Astro.props;
---

<a class:list={["logo", `logo--${tone}`, `logo--${size}`]} href="/" aria-label={`${business.name} home`}>
  <img class="logo__img logo__img--on-dark" src="/brand/logo-on-dark.webp" alt="" width="235" height="160" decoding="async" />
  <img class="logo__img logo__img--on-light" src="/brand/logo-on-light.webp" alt="" width="235" height="160" decoding="async" />
</a>

<style>
  .logo { display: inline-flex; align-items: center; flex: none; }
  .logo__img { height: 50px; width: auto; }
  .logo--lg .logo__img { height: 64px; }
  .logo--light .logo__img--on-light { display: none; }
  .logo--dark .logo__img--on-dark { display: none; }
</style>
