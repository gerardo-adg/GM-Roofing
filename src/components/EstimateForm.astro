---
/**
 * Netlify Forms estimate request. Keep `data-netlify`, the hidden `form-name`
 * input and the honeypot, or Netlify will stop capturing submissions.
 */
import Icon from "./Icon.astro";
import { services } from "../data/services";

const options = [...services.map((s) => s.name), "Not sure yet"];
---

<form
  class="form"
  name="estimate-request"
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="company-website"
>
  <input type="hidden" name="form-name" value="estimate-request" />
  <p class="visually-hidden">
    <label>Leave this field blank: <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <fieldset class="form__group">
    <legend>What do you need help with?</legend>
    <div class="chips">
      {
        options.map((o, i) => (
          <label class="chip">
            <input type="radio" name="service" value={o} required={i === 0} />
            <span>{o}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="form__row">
    <div class="field">
      <label for="f-name">Full name</label>
      <input type="text" id="f-name" name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-phone">Phone</label>
      <input type="tel" id="f-phone" name="phone" autocomplete="tel" inputmode="tel" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="f-email">Email</label>
      <input type="email" id="f-email" name="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="f-zip">Property address or ZIP</label>
      <input type="text" id="f-zip" name="zip" autocomplete="postal-code" required />
    </div>
  </div>
  <div class="field">
    <label for="f-message">Tell us about your roof <span>(optional)</span></label>
    <textarea id="f-message" name="message" rows="4" placeholder="Roof age, material, what you're noticing…"></textarea>
  </div>

  <button type="submit" class="btn btn--accent btn--block form__submit">
    Request my free estimate <Icon name="arrow" class="arrow" />
  </button>
  <p class="form__note">
    <Icon name="shield" size={16} /> No obligation. We'll only use your details to respond to this request.
  </p>
</form>

<style>
  .form { display: grid; gap: 1.25rem; }
  .form__group { border: 0; padding: 0; min-width: 0; }
  legend, .field label {
    display: block;
    margin-bottom: 0.55rem;
    font-size: var(--fs-sm);
    font-weight: 550;
  }
  .field label span { font-weight: 400; color: var(--steel); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; }
  .chip input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid rgb(10 26 43 / 0.16);
    background: var(--white);
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .chip:hover span { border-color: rgb(10 26 43 / 0.4); }
  .chip input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .form__row { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .form__row { grid-template-columns: 1fr 1fr; } }

  input:not([type="radio"]), textarea {
    width: 100%;
    min-height: 54px;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid rgb(10 26 43 / 0.16);
    background: var(--white);
    font-size: 1rem; /* ≥16px prevents iOS zoom on focus */
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; min-height: 120px; }
  input::placeholder, textarea::placeholder { color: #8b97a3; }
  input:not([type="radio"]):hover, textarea:hover { border-color: rgb(10 26 43 / 0.32); }
  input:not([type="radio"]):focus, textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgb(10 26 43 / 0.08);
  }
  .form__submit { margin-top: 0.5rem; min-height: 58px; font-size: var(--fs-base); }
  .form__note :global(svg) { flex: none; }
  .form__note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--steel);
    text-align: center;
  }
</style>
