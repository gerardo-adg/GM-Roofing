---
/**
 * Netlify Forms estimate request. Keep `data-netlify`, the hidden `form-name`
 * input and the honeypot, or Netlify will stop capturing submissions.
 */
import Icon from "./Icon.astro";
import { services } from "../data/services";

const options = [...services.map((s) => s.name), "Not sure yet"];
---

<form
  class="form"
  name="estimate-request"
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="company-website"
>
  <input type="hidden" name="form-name" value="estimate-request" />
  <p class="visually-hidden">
    <label>Leave this field blank: <input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field">
    <label for="f-service">What do you need help with?</label>
    <div class="select">
      <select id="f-service" name="service" required>
        <option value="" disabled selected>Choose a service</option>
        {options.map((o) => <option value={o}>{o}</option>)}
      </select>
      <Icon name="chevron-down" size={18} class="select__icon" />
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label for="f-name">Full name</label>
      <input type="text" id="f-name" name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-phone">Phone</label>
      <input type="tel" id="f-phone" name="phone" autocomplete="tel" inputmode="tel" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="f-email">Email</label>
      <input type="email" id="f-email" name="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="f-zip">Property address or ZIP</label>
      <input type="text" id="f-zip" name="zip" autocomplete="postal-code" required />
    </div>
  </div>
  <div class="field">
    <label for="f-message">Tell us about your roof <span>(optional)</span></label>
    <textarea id="f-message" name="message" rows="4" placeholder="Roof age, material, what you're noticing…"></textarea>
  </div>

  <label class="consent">
    <input type="checkbox" name="marketing-consent" value="yes" />
    <span>
      Send me occasional roof care tips and offers from GM Roofing by email or text. Optional. Reply STOP to opt out anytime. Message and data rates may apply.
    </span>
  </label>

  <button type="submit" class="btn btn--accent btn--block form__submit">
    Request my free estimate
  </button>
  <p class="form__note">
    <Icon name="shield" size={16} /> <span>No obligation. We'll use your details to respond to your request. See our <a href="/privacy-policy/">privacy policy</a>.</span>
  </p>
</form>

<style>
  .form { display: grid; gap: 1.25rem; }
  .field label {
    display: block;
    margin-bottom: 0.55rem;
    font-size: var(--fs-sm);
    font-weight: 550;
  }
  .field label span { font-weight: 400; color: var(--steel); }

  /* Service dropdown, styled to match the text fields */
  .select { position: relative; }
  .select select {
    width: 100%;
    min-height: 54px;
    padding: 0.85rem 2.75rem 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid rgb(10 26 43 / 0.16);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .select select:invalid { color: #8b97a3; }
  .select select option { color: var(--ink); }
  .select select:hover { border-color: rgb(10 26 43 / 0.32); }
  .select select:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgb(10 26 43 / 0.08); }
  .select :global(.select__icon) { position: absolute; right: 1rem; top: 50%; translate: 0 -50%; pointer-events: none; color: var(--steel); }

  .form__row { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .form__row { grid-template-columns: 1fr 1fr; } }

  input:not([type="checkbox"]), textarea {
    width: 100%;
    min-height: 54px;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid rgb(10 26 43 / 0.16);
    background: var(--white);
    font-size: 1rem; /* ≥16px prevents iOS zoom on focus */
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; min-height: 120px; }
  input::placeholder, textarea::placeholder { color: #8b97a3; }
  input:not([type="checkbox"]):hover, textarea:hover { border-color: rgb(10 26 43 / 0.32); }
  input:not([type="checkbox"]):focus, textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgb(10 26 43 / 0.08);
  }
  .consent { display: flex; gap: 0.7rem; align-items: flex-start; font-size: var(--fs-xs); line-height: 1.5; color: var(--steel); cursor: pointer; }
  .consent input { flex: none; width: 18px; height: 18px; min-height: 0; margin-top: 0.1rem; padding: 0; accent-color: var(--accent); cursor: pointer; }
  .form__note a { text-decoration: underline; text-underline-offset: 2px; }
  .form__submit { margin-top: 0.5rem; min-height: 58px; font-size: 0.875rem; }
  .form__note :global(svg) { flex: none; }
  .form__note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--steel);
    text-align: center;
  }
</style>
