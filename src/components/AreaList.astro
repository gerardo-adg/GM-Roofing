---
import Icon from "./Icon.astro";
import { business } from "../data/business";

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
---

<ul role="list" class:list={["areas", `areas--${tone}`, { "areas--three": business.cities.length % 3 === 0 }]}>
  {
    business.cities.map((c, i) => (
      <li id={slug(c)} data-reveal style={`--d:${i % 4}`}>
        <Icon name="pin" size={18} />
        <span>{c}</span>
        <small>CA</small>
      </li>
    ))
  }
</ul>

<style>
  .areas { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line); }
  .areas li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.15rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-lg);
    font-weight: 550;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }
  .areas li :global(svg) { color: var(--accent); flex: none; }
  .areas small { margin-left: auto; font-size: var(--fs-xs); font-weight: 500; color: var(--steel); letter-spacing: 0.1em; }
  .areas li:target { background: var(--paper); }
  .areas--dark { border-color: var(--line-dark); }
  .areas--dark li { border-color: var(--line-dark); }
  .areas--dark li :global(svg) { color: var(--accent-soft); }
  .areas--dark small { color: rgb(255 255 255 / 0.5); }

  @media (min-width: 560px) {
    .areas { grid-template-columns: repeat(2, 1fr); column-gap: 2rem; }
  }
  /* Three columns only when the list divides evenly; otherwise keep two */
  @media (min-width: 960px) {
    .areas { column-gap: 3rem; }
    .areas--three { grid-template-columns: repeat(3, 1fr); }
  }
</style>
