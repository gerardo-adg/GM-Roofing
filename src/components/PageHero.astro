---
import Icon from "./Icon.astro";
import RoofLines from "./RoofLines.astro";
import MuxBackground from "./MuxBackground.astro";
import type { Crumb } from "../lib/schema";
import { business, hasPhone } from "../data/business";
import { hasClip, type MuxClip } from "../data/media";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  /** May contain <em> for the blue accent. */
  title: string;
  lede?: string;
  breadcrumbs?: Crumb[];
  cta?: string;
  showPhone?: boolean;
  /** Optional Mux background loop. */
  clip?: MuxClip;
  /** Optional background photo (used when there's no video). */
  image?: { src: ImageMetadata; alt: string };
}
const { eyebrow, title, lede, breadcrumbs = [], cta, showPhone = true, clip, image } = Astro.props;
const withVideo = hasClip(clip);
const withImage = !withVideo && Boolean(image);
---

<section class:list={["phero on-dark", { "phero--video": withVideo || withImage }]}>
  {
    withVideo ? (
      <div class="phero__media">
        <MuxBackground clip={clip!} eager />
        <div class="phero__shade" />
      </div>
    ) : withImage ? (
      <div class="phero__media">
        <Picture
          src={image!.src}
          alt={image!.alt}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="phero__img"
        />
        <div class="phero__shade" />
      </div>
    ) : (
      <div data-reveal="draw" class="phero__art">
        <RoofLines class="phero__lines" draw />
      </div>
    )
  }
  <div class="container phero__inner">
    {
      breadcrumbs.length > 1 && (
        <nav aria-label="Breadcrumb" class="crumbs" data-reveal>
          <ol role="list">
            {breadcrumbs.map((b, i) =>
              i === breadcrumbs.length - 1 ? (
                <li aria-current="page">{b.label}</li>
              ) : (
                <li><a href={b.href}>{b.label}</a></li>
              )
            )}
          </ol>
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow" data-reveal style="--d:1">{eyebrow}</span>}
    <h1 data-reveal="lines" style="--d:1"><span class="l"><span class="l__in" set:html={title} /></span></h1>
    {lede && <p class="lede" data-reveal style="--d:3">{lede}</p>}
    {
      cta && (
        <div class="btn-row" data-reveal style="--d:4">
          <a class="btn btn--accent" href="/contact/">{cta}</a>
          {showPhone && hasPhone && (
            <a class="btn btn--ghost" href={`tel:${business.phone.tel}`}>
              <Icon name="phone" /> {business.phone.display}
            </a>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(165deg, var(--navy) 0%, var(--ink) 55%);
    color: var(--white);
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6.5rem));
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }
  .phero--video { min-height: min(78svh, 760px); display: flex; align-items: flex-end; }
  .phero--video .phero__inner { width: 100%; }
  .phero__media { position: absolute; inset: 0; z-index: -1; }
  .phero__media { background: #050505; }
  .phero__media :global(.phero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Black tint like the homepage hero, darker on the left where the text sits */
  .phero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.35) 55%, rgb(0 0 0 / 0.15) 100%),
      linear-gradient(0deg, rgb(0 0 0 / 0.6) 0%, transparent 50%),
      linear-gradient(180deg, rgb(0 0 0 / 0.35) 0%, transparent 25%);
  }
  .phero--video h1 { filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.6)) drop-shadow(0 6px 24px rgb(0 0 0 / 0.5)); }
  .phero--video .eyebrow, .phero--video .lede, .phero--video .crumbs { text-shadow: 0 1px 2px rgb(0 0 0 / 0.7), 0 0 20px rgb(0 0 0 / 0.5); }
  .phero__art { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .phero :global(.phero__lines) {
    position: absolute;
    right: -4%;
    bottom: -2px;
    width: min(760px, 95%);
    color: rgb(255 255 255 / 0.09);
  }
  .phero__inner { display: grid; justify-items: start; }
  .phero h1 { margin-top: 1.25rem; max-width: 18ch; }
  .phero .lede { margin-top: 1.5rem; }
  .phero .btn-row { margin-top: 2.25rem; width: 100%; }

  .crumbs { margin-bottom: 2rem; font-size: var(--fs-xs); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; color: rgb(255 255 255 / 0.55); }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; opacity: 0.5; }
  .crumbs a:hover { color: var(--white); }
  .crumbs [aria-current] { color: rgb(255 255 255 / 0.9); }
</style>
