---
/** One project on the Our Work grid / homepage strip: a photo or a silent Mux loop with a caption. */
import { Picture } from "astro:assets";
import MuxBackground from "./MuxBackground.astro";
import Icon from "./Icon.astro";
import { getService } from "../data/services";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  sizes?: string;
}
const { project: p, sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" } = Astro.props;
const service = getService(p.service);
---

<a class="ptile" href={`/${p.service}/`}>
  {
    p.clip?.playbackId ? (
      <MuxBackground clip={p.clip} />
    ) : (
      p.photo && (
        <Picture
          src={p.photo}
          alt={p.alt}
          formats={["avif", "webp"]}
          widths={[480, 800, 1200, 1600]}
          sizes={sizes}
          loading="lazy"
          class="ptile__img"
          style={p.position ? `object-position:${p.position}` : undefined}
        />
      )
    )
  }
  <span class="ptile__cap">
    <span class="ptile__text">
      {service && <span class="ptile__svc">{service.name}</span>}
      <strong>{p.title}</strong>
      {p.location && <span class="ptile__loc">{p.location}</span>}
    </span>
    <span class="ptile__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
  </span>
  {p.clip?.playbackId && <span class="visually-hidden">{p.alt}</span>}
</a>

<style>
  .ptile {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--ink);
    isolation: isolate;
  }
  .ptile :global(.ptile__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .ptile:hover :global(.ptile__img) { transform: scale(1.03); }
  .ptile__cap {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 3rem 1.25rem 1.15rem;
    color: var(--white);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
  }
  .ptile__text { display: grid; gap: 0.2rem; }
  .ptile__svc { font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-soft); }
  .ptile strong { font-size: 1.05rem; font-weight: 650; line-height: 1.25; }
  .ptile__loc { font-size: var(--fs-sm); color: rgb(255 255 255 / 0.75); }
  .ptile__arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.35);
    transition: background-color 0.25s, color 0.25s;
  }
  .ptile:hover .ptile__arrow { background: var(--white); color: var(--ink); }
</style>
