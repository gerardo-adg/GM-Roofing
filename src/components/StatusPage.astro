---
/** Centered message page used by /thank-you/ and the 404. */
import BaseLayout from "../layouts/BaseLayout.astro";
import RoofLines from "./RoofLines.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede: string;
}
const { title, description, eyebrow, heading, lede } = Astro.props;
---

<BaseLayout title={title} description={description} finalCta={false} noindex>
  <section class="status on-dark">
    <RoofLines class="status__lines" />
    <div class="container status__inner">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={heading} />
      <p class="lede">{lede}</p>
      <div class="btn-row"><slot /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .status {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 4rem) 6rem;
    background:
      radial-gradient(70% 80% at 50% 0%, rgb(23 59 96 / 0.9), transparent 70%),
      var(--ink);
    color: var(--white);
    text-align: center;
  }
  .status :global(.status__lines) {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: -2px;
    width: min(900px, 120%);
    translate: -50% 0;
    color: rgb(255 255 255 / 0.06);
  }
  .status__inner { display: grid; justify-items: center; }
  .status h1 { margin-top: 1.25rem; max-width: 14ch; }
  .status .lede { margin-top: 1.5rem; }
  .status .btn-row { margin-top: 2.5rem; justify-content: center; }
</style>
