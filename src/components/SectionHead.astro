---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: "left" | "center" | "split";
  id?: string;
}
const { eyebrow, title, lede, align = "left", id } = Astro.props;
---

<header class:list={["shead", `shead--${align}`]}>
  <div>
    {eyebrow && <span class="eyebrow" data-reveal>{eyebrow}</span>}
    <h2 id={id} data-reveal style="--d:1"><Fragment set:html={title} /></h2>
  </div>
  {lede && <p class="lede" data-reveal style="--d:2">{lede}</p>}
</header>

<style>
  .shead { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .shead h2 { margin-top: 1.1rem; max-width: 18ch; }
  .shead--center { text-align: center; justify-items: center; }
  .shead--center h2 { margin-inline: auto; }
  .shead--center .eyebrow::after { content: ""; width: 1.5rem; height: 1px; background: currentColor; opacity: 0.6; }
  @media (min-width: 960px) {
    .shead--split { grid-template-columns: 1.3fr 1fr; align-items: end; gap: 4rem; }
    .shead--split .lede { justify-self: end; }
  }
</style>
