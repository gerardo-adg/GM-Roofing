---
import Icon from "./Icon.astro";
import RoofLines from "./RoofLines.astro";
import { business, hasPhone } from "../data/business";
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__card on-dark" data-reveal>
      <div data-reveal="draw" class="cta__art" aria-hidden="true">
      <RoofLines class="cta__lines" draw />
      </div>
      <div class="cta__copy">
        <span class="eyebrow">{business.primaryRegion}</span>
        <h2 id="cta-title" data-reveal="lines"><span class="l"><span class="l__in">Have a roof question?</span></span><span class="l"><span class="l__in"><em>Start with a free estimate.</em></span></span></h2>
        <p class="lede">
          Tell us what you're seeing. We'll look at the roof in person and put the scope and price in writing, with no obligation.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--accent" href="/contact/">Request a free estimate <Icon name="arrow" class="arrow" /></a>
        {
          hasPhone && (
            <a class="btn btn--ghost" href={`tel:${business.phone.tel}`}>
              <Icon name="phone" /> {business.phone.display}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(4rem, 8vw, 6rem); background: var(--white); }
  .cta__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 2.5rem;
    align-items: end;
    padding: clamp(2.25rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(160deg, var(--navy) 0%, var(--ink) 70%);
    color: var(--white);
  }
  .cta__art { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .cta__card :global(.cta__lines) {
    position: absolute;
    right: -6%;
    bottom: -10%;
    width: min(720px, 90%);
    color: rgb(255 255 255 / 0.08);
  }
  .cta h2 { margin-top: 1.25rem; max-width: 14ch; }
  .cta .lede { margin-top: 1.25rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 479px) {
    .cta__actions > .btn { flex: 1 1 100%; }
  }
  @media (min-width: 960px) {
    .cta__card { grid-template-columns: 1.5fr 1fr; }
    .cta__actions { justify-content: flex-end; }
  }
</style>
